# =================================================================================================
# environment variables
# =================================================================================================

# =================================================================================================
# app
# =================================================================================================

NUXT_PUBLIC_APP_BASE_URL="http://localhost:3000"
# imprint service
NUXT_PUBLIC_APP_IMPRINT_CUSTOM_CONFIG="disabled"
NUXT_PUBLIC_APP_IMPRINT_SERVICE_BASE_URL="https://imprint.acdh.oeaw.ac.at"
NUXT_PUBLIC_APP_SERVICE_ID="29161"
# web crawlers
NUXT_PUBLIC_APP_BOTS="disabled"

# Nuxt Studio GitHub OAuth
# Note that these work with nuxt-studio v1.7 - the official docs document the behavior
# for the not-yet-released v1.8.
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=


# =================================================================================================
# analytics
# =================================================================================================

# NUXT_PUBLIC_APP_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_APP_MATOMO_BASE_URL="https://matomo.acdh.oeaw.ac.at"
# NUXT_PUBLIC_APP_MATOMO_ID=
